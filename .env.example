# ============================================================================
# YeBetWeg — Environment Variables Template
#
# Copy to `.env.local` (gitignored) and fill in real values.
# NEVER commit real credentials. This file must contain placeholders only.
#
# Secrets rotation: if any real secret ever reaches git, rotate it in the
# provider dashboard (Supabase → Settings → API; Chapa dashboard; Resend
# dashboard) before purging history. See memory/security/project_rules.md.
# ============================================================================

# --- Supabase (frontend runtime) --------------------------------------------
# Safe to expose via VITE_ prefix: anon/public key is client-side by design
# (RLS is the security boundary). Find both in Supabase → Settings → API.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# --- Supabase (server-side / migrations / edge functions) -------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>   # SECRET — server only
SUPABASE_DB_URL=postgres://postgres:<your-db-password>@db.<your-project-ref>.supabase.co:5432/postgres

# --- Chapa payment gateway (https://chapa.co) --------------------------------
# Sandbox keys start with CHAPUBK_TEST_ / CHASECK_TEST_.
# Live keys start with CHAPUBK_LIVE_ / CHASECK_LIVE_.
VITE_CHAPA_PUBLIC_KEY=CHAPUBK_TEST-<your-chapa-public-key>
CHAPA_SECRET_KEY=CHASECK_TEST-<your-chapa-secret-key>
CHAPA_WEBHOOK_SECRET=CHAPWH-<your-chapa-webhook-secret>

# --- Resend email service (https://resend.com) -------------------------------
RESEND_API_KEY=re_<your-resend-api-key>

# --- App config ---------------------------------------------------------------
# Public base URL used for payment callbacks, sitemap generation, SEO tags.
# Dev: http://localhost:5173 — Production: https://yebetweg.com
VITE_APP_BASEURL=http://localhost:5173
