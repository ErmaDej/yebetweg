# Supabase frontend runtime
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Supabase admin / migration access
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Direct database connection string used by the migration runner
SUPABASE_DB_URL=postgres://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Chapa Payment Gateway Credentials (Test Keys)
VITE_CHAPA_PUBLIC_KEY=CHAPUBK_TEST-<your-chapa-public-key>
VITE_CHAPA_SECRET_KEY=CHASECK_TEST-<your-chapa-secret-key>

# TeleBirr Payment Gateway Credentials
VITE_TELEBIRR_MERCHANT_APP_ID=<your-merchant-app-id>
VITE_TELEBIRR_FABRIC_APP_ID=<your-fabric-app-id>
VITE_TELEBIRR_SHORT_CODE=<your-short-code>
VITE_TELEBIRR_API_KEY=<your-telebirr-api-key>

# Optional publishable / secret keys
SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
SUPABASE_SECRET_KEY=<your-secret-key>

# Edge Function Secrets (set in Supabase Dashboard -> Edge Functions -> Secrets)
CHAPA_SECRET_KEY="CHASECK_TEST-<your-chapa-secret-key>"
CHAPA_WEBHOOK_SECRET="CHAPWH_TEST-<your-chapa-webhook-secret>"

# Resend email service API key (used for email notifications, newsletters, etc.)
RESEND_API_KEY=re_<your-resend-api-key>

# App base URL (update for production)
VITE_APP_BASEURL=http://localhost:8080
