# Local development environment overrides.
# Copy this file to .env.local and update values for your local machine.

# Optional local TeleBirr mock endpoint.
# Use the host bridge IP if your Supabase Functions runtime is running in a container.
TELEBIRR_API_URL=http://172.17.0.1:8082/v1

# Optional local-only TeleBirr credentials for development.
# These should never be committed to source control.
VITE_TELEBIRR_API_KEY=Bearer your-local-telebirr-token
VITE_TELEBIRR_MERCHANT_APP_ID=<your-merchant-app-id>
VITE_TELEBIRR_FABRIC_APP_ID=<your-fabric-app-id>
VITE_TELEBIRR_SHORT_CODE=<your-short-code>

# Local Chapa secret for backend service only.
CHAPA_SECRET_KEY=CHASECK_TEST-your-local-backend-secret

# Optional dev bypass for TeleBirr service if you need to skip auth during local testing.
ALLOW_DEV_BYPASS=true
DEV_BYPASS_TOKEN=your-local-dev-bypass-token
